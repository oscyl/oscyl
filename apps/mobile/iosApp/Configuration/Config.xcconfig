TEAM_ID=
BUNDLE_ID=io.github.oscyl
APP_NAME=Oscyl

// The release version's numeric part (scripts/version.sh; checked by scripts/release-check.sh).
MARKETING_VERSION=0.6.0
// The build number, the same as Android's versionCode (scripts/version.sh).
CURRENT_PROJECT_VERSION=60099
// The lowest iOS Kotlin/Native 2.4 (and so Compose Multiplatform 1.12) supports.
IPHONEOS_DEPLOYMENT_TARGET=15.0
// The Kotlin framework and the Rust core exist for arm64 only (iosArm64,
// iosSimulatorArm64): no Intel simulator slice.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
