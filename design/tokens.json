{
  "$comment": "Oscyl design tokens: the one source for every app. The Linux build generates CSS custom properties (--oscyl-<role>) from this file; the Android app will generate its Material 3 colour schemes, type scale and motion specs from it. World: Ulm Hi-Fi. Colour only ever means a function: 'on' (green) is connected, synced, audio live; 'act' (orange) needs action (edited, the sync count). Everything else is achromatic.",
  "color": {
    "light": {
      "ground": "#e7e6e2",
      "sidebar": "#dedcd7",
      "list": "#ecebe7",
      "raised": "#f6f5f2",
      "plate": "#2a2b2c",
      "on-plate": "#ecebe7",
      "plate-legend": "#a9a8a3",
      "rule": "#cbc9c3",
      "rule-strong": "#8a8882",
      "ink": "#1d1e1f",
      "legend": "#62615c",
      "on": "#2c8a45",
      "act": "#a54c08",
      "on-act": "#ffffff",
      "graph-faint": "rgb(29 30 31 / 30%)",
      "hover": "rgb(29 30 31 / 6%)",
      "press": "rgb(29 30 31 / 11%)",
      "focus": "#1d1e1f",
      "shadow": "rgb(29 30 31 / 14%)"
    },
    "dark": {
      "ground": "#202122",
      "sidebar": "#1a1b1c",
      "list": "#232425",
      "raised": "#2b2c2d",
      "plate": "#d9d8d3",
      "on-plate": "#202122",
      "plate-legend": "#56554f",
      "rule": "#353637",
      "rule-strong": "#6b6c6d",
      "ink": "#ecebe7",
      "legend": "#9d9c97",
      "on": "#3fae5a",
      "act": "#f08a24",
      "on-act": "#202122",
      "graph-faint": "rgb(236 235 231 / 34%)",
      "hover": "rgb(236 235 231 / 6%)",
      "press": "rgb(236 235 231 / 11%)",
      "focus": "#ecebe7",
      "shadow": "rgb(0 0 0 / 40%)"
    },
    "amoled": {
      "ground": "#000000",
      "sidebar": "#000000",
      "list": "#050505",
      "raised": "#151515",
      "plate": "#d9d8d3",
      "on-plate": "#000000",
      "plate-legend": "#56554f",
      "rule": "#262626",
      "rule-strong": "#5f5f5f",
      "ink": "#ecebe7",
      "legend": "#9d9c97",
      "on": "#3fae5a",
      "act": "#f08a24",
      "on-act": "#000000",
      "graph-faint": "rgb(236 235 231 / 32%)",
      "hover": "rgb(236 235 231 / 7%)",
      "press": "rgb(236 235 231 / 12%)",
      "focus": "#ecebe7",
      "shadow": "rgb(0 0 0 / 0%)"
    }
  },
  "type": {
    "display": { "family": "Albert Sans", "weight": 700, "tracking_em": -0.02, "use": "program titles only" },
    "text": { "family": "platform", "use": "everything else: Adwaita Sans on GNOME, Roboto on Android" },
    "legend": { "size_em": 0.846, "weight": 500, "tracking_em": 0.08, "case": "upper", "use": "section legends" },
    "numerals": "tabular"
  },
  "shape": {
    "radius_px": 6,
    "radius_inner_px": 4,
    "radius_panel_px": 10,
    "rule_px": 1
  },
  "space": {
    "unit_px": 4,
    "steps": [4, 8, 12, 16, 24, 32]
  },
  "motion": {
    "fast_ms": 90,
    "base_ms": 150,
    "slow_ms": 220,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "use": "fast: value indicators follow input; base: selection and state changes; slow: panels and pages"
  },
  "mobile": {
    "$comment": "The phone app's physical feel (2026-11-13 owner phone test). The floating shadow lifts the island, rail, sheets and the lifted top bar: a close layer and a soft layer; on dark its rim sits near rule-strong (a lighter fill erased the rules inside sheets), AMOLED draws a 1 dp rule-strong rim (2026-11-14 owner: islands must read as floating, like Claude's composer: flat fill, crisp outline).",
    "floating": {
      "near_radius_dp": 3,
      "near_offset_dp": 1,
      "near_alpha": 0.9,
      "far_radius_dp": 28,
      "far_offset_dp": 10,
      "far_alpha": 0.75,
      "radius_dp": 14
    },
    "knob": {
      "travel_dp": 220,
      "fine_gain": 0.35,
      "fine_speed_dp_per_ms": 0.15,
      "spring_stiffness": 1100,
      "spring_stiffness_comparing": 230,
      "glide_from": 0.12,
      "disc_dp": 64,
      "target_dp": 96,
      "grab_dp": 76
    },
    "rail_anchor_dp": 16,
    "color": {
      "$comment": "Mobile-only overrides of the shared colour roles (the Linux app keeps the shared ones). rule-strong is the outline of every outlined button, field and segment frame: on a phone, under daylight, it reaches 3:1 against the surfaces it stands on (light ground, dark and AMOLED raised).",
      "light": { "rule-strong": "#7d7b75" },
      "dark": { "rule-strong": "#77787a" },
      "amoled": { "rule-strong": "#6c6c6c" }
    }
  }
}
